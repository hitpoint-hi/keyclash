      "kind": "nav",
      "description": "Text tabs with an underline and separate keyboard focus.",
      "html": "<nav class=\"ds-nav\" role=\"tablist\" aria-label=\"Main views\"><button role=\"tab\" aria-selected=\"true\">Look up keys</button><button role=\"tab\" aria-selected=\"false\">Keyboard map</button></nav>",
      "css": ".ds-nav{display:flex;gap:20px;background:#15171C}.ds-nav button{background:transparent;color:#8E95A3;border:0;border-bottom:2.5px solid transparent;height:34px;padding:0 3px;font:13.5px -apple-system,sans-serif}.ds-nav button[aria-selected=true]{color:#EEF0F4;border-bottom-color:#5AA7FF}.ds-nav button:hover{color:#C3C8D2}.ds-nav button:focus-visible{outline:2px solid #5AA7FF;outline-offset:-2px}"
    },
    {
      "name": "Conflict filter",
      "kind": "chip",
      "description": "Toggle that filters conflict kinds.",
      "html": "<button class=\"ds-chip\" role=\"checkbox\" aria-checked=\"true\"><span class=\"ds-chip-dot\" aria-hidden=\"true\"></span>Clash</button>",
      "css": ".ds-chip{display:inline-flex;align-items:center;gap:6px;height:26px;background:#362329;color:#EEF0F4;border:1px solid #80383E;border-radius:13px;padding:0 11px 0 9px;font:500 12.5px -apple-system,sans-serif;cursor:pointer}.ds-chip-dot{width:8px;height:8px;border-radius:50%;background:#FF5C61}.ds-chip[aria-checked=false]{background:transparent;border-color:#272B34;color:#8E95A3}.ds-chip[aria-checked=false]:hover{background:#22262E;border-color:#3A3F4C;color:#C3C8D2}.ds-chip[aria-checked=false] .ds-chip-dot{background:transparent;border:1.5px solid #C77982}.ds-chip:focus-visible{outline:2px solid #5AA7FF;outline-offset:-2px}"
    },
    {
      "name": "Shortcut card",
      "kind": "card",
      "description": "Container for related shortcut observations.",
      "html": "<section class=\"ds-card\"><strong>Matched shortcuts</strong><p>One unique match per key observation.</p></section>",
      "css": ".ds-card{background:#181B21;color:#EEF0F4;border:1px solid #272B34;border-radius:12px;padding:12px 16px;font:13.5px -apple-system,sans-serif}.ds-card p{color:#8E95A3;font-size:12.5px}",
