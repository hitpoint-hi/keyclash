  "narrative": {
    "northStar": "Compact shortcut reference",
    "overview": "Preserve the existing compact interface that Bobby confirmed on 2026-11-12.\nThe interface supports repeated lookup and comparison. App names, actions, and key combinations carry the hierarchy.\nThis record describes the current Rust/egui implementation. It does not establish a new visual direction.",
    "keyCharacteristics": [
      "Dense shortcut rows grouped by app or conflict.",
      "Native macOS interface fonts and recognizable modifier symbols.",
      "Light, dark, and system appearance choices.",
      "Explicit origin, uncertainty, and running-state labels."
    ],
    "rules": [
      {
        "name": "The Evidence Rule",
        "body": "A status color accompanies a text label. Color alone does not establish a conflict or action outcome.",
        "section": "colors"
      }
    ],
    "dos": [
      "Preserve the compact interface and established icon.",
      "Use the active theme and shared controls.",
      "Check keyboard focus and macOS accessibility output after custom painting changes.",
      "Keep uncertain usage matches separate from uniquely matched shortcuts."
    ],
    "donts": [
